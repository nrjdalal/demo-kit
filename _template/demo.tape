# Template. Render from the repo root: vhs .github/assets/demo.tape
Output .github/assets/demo.gif

Require node

Set Shell zsh
Set FontSize 17
Set Width 1120
Set Height 720
Set Padding 22
Set Theme "Catppuccin Mocha"
Set TypingSpeed 55ms

Hide
Type "source .github/assets/setup.sh" Enter
Type "clear" Enter
Show

Sleep 800ms
Type "cli --help" Sleep 300ms Enter
Sleep 2500ms
# Type "cli <command>" Sleep 300ms Enter
# Sleep 3000ms
Sleep 1200ms
