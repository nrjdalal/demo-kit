# gitpick interactive `-i` file-tree picker: select two folders, confirm.
# Render from the demo-kit root: vhs gitpick/demo-interactive.tape
Output gitpick/demo-interactive.gif

Require node

Set Shell zsh
Set FontSize 17
Set Width 1120
Set Height 760
Set Padding 22
Set Theme "Catppuccin Mocha"
Set TypingSpeed 55ms

Hide
Type "source gitpick/setup.sh" Enter
Type "clear" Enter
Show

Sleep 600ms
Type "gitpick nrjdalal/gitpick -i" Sleep 300ms Enter
Sleep 4200ms
Down Sleep 700ms
Space Sleep 900ms
Down Sleep 250ms Down Sleep 250ms Down Sleep 250ms Down Sleep 250ms Down Sleep 250ms Down Sleep 600ms
Space Sleep 1000ms
Type "c" Sleep 300ms
Sleep 4000ms
Sleep 1200ms
